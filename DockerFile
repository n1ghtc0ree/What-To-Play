FROM python:3.13-slim

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY backend/app/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend only
COPY backend/app ./app

# Copy requirements to root for Render compatibility
COPY backend/app/requirements.txt ./requirements.txt

# Set environment variables
ENV DB_PATH=/app/app.db

# Build argument for Steam API key
ARG STEAM_DEVELOPER_KEY
ENV STEAM_DEVELOPER_KEY=${STEAM_DEVELOPER_KEY}

# Build the database (requires STEAM_DEVELOPER_KEY)
RUN if [ -n "$STEAM_DEVELOPER_KEY" ]; then python -m backend.app.services.steam_db_builder; else echo "Warning: STEAM_DEVELOPER_KEY not provided, database will not be built"; fi

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]